{
  "name": "starxmailer",
  "version": "1.0.0",
  "description": "Kirim email dengan mudah melalui HTTP API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Astra-Devl/starxmailer.git"
  },
  "homepage": "https://github.com/Astra-Devl/starxmailer#readme",
  "bugs": {
    "url": "https://github.com/Astra-Devl/starxmailer/issues"
  },
  "keywords": [
    "starxmailer",
    "mailer",
    "api",
    "email"
  ],
  "author": "Astra-Devl",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
